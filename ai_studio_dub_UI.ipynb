def on_dub_click(b):
    with output_area:
        clear_output()
        print("⏳ Dubbing... Please wait.")
        try:
            from gradio_client import Client, handle_file
            client = Client("https://yara85-aigoldendub.hf.space/")
            result = client.predict(
                media_file=handle_file(input_file_path),
                voice_name=voice_name,
                source_lang=source_language,
                target_lang=target_language,
                api_name="/dub_only"
            )
            print(f"✅ Dubbing Complete! Result: {result}")
            if isinstance(result, str) and os.path.exists(result):
                ext = os.path.splitext(result)[1]
                final_path = f"output_media/dubbed_output{ext}"
                shutil.copy(result, final_path)
                print(f"📥 Downloading {final_path}...")
                files.download(final_path)
            elif isinstance(result, (list, tuple)):
                for idx, item in enumerate(result):
                    if isinstance(item, str) and os.path.exists(item):
                        ext = os.path.splitext(item)[1]
                        final_path = f"output_media/dubbed_output_{idx}{ext}"
                        shutil.copy(item, final_path)
                        print(f"📥 Downloading {final_path}...")
                        files.download(final_path)
        except Exception as e:
            print(f"❌ Error: {e}")

btn_transcribe.on_click(on_transcribe_click)
btn_translate.on_click(on_translate_click)
btn_dub.on_click(on_dub_click)

display(widgets.HBox([btn_transcribe, btn_translate, btn_dub]))
display(output_area)

#@title ✂️ Dub long files in 5-minute chunks
#@markdown هر تکه جدا Transcribe، Translate و Dub می‌شود و آخر به هم می‌چسبد.
#@markdown این سلول را بعد از سلول Install و بعد از آپلود فایل اجرا کن.

import os, math, shutil, subprocess, time
from google.colab import files

CHUNK_SEC = 300  # 5 minutes
SPACE = "https://yara85-aigoldendub.hf.space/"

def run(cmd):
    subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)

def media_duration(path):
    out = subprocess.check_output([
        "ffprobe", "-v", "error", "-show_entries", "format=duration",
        "-of", "default=nw=1:nk=1", path
    ]).decode().strip()
    return float(out)

def has_video(path):
    try:
        subprocess.check_output([
            "ffprobe", "-v", "error", "-select_streams", "v:0",
            "-show_entries", "stream=codec_type", "-of", "csv=p=0", path
        ])
        return True
    except subprocess.CalledProcessError:
        return False

def split_media(src, out_dir):
    os.makedirs(out_dir, exist_ok=True)
    duration = media_duration(src)
    ext = os.path.splitext(src)[1] or ".mp4"
    parts = []
    start = 0.0
    i = 0
    while start < duration - 0.05:
        part = os.path.join(out_dir, f"part_{i:03d}{ext}")
        run(["ffmpeg", "-y", "-ss", f"{start:.3f}", "-t", str(CHUNK_SEC),
             "-i", src, "-c", "copy", "-avoid_negative_ts", "make_zero", part])
        parts.append(part)
        start += CHUNK_SEC
        i += 1
    return parts

def save_result(result, dest):
    if isinstance(result, str) and os.path.exists(result):
        shutil.copy(result, dest)
        return dest
    if isinstance(result, (list, tuple)):
        for item in result:
            if isinstance(item, str) and os.path.exists(item):
                shutil.copy(item, dest)
                return dest
    with open(dest, "w", encoding="utf-8") as f:
        f.write(str(result))
    return dest

def shift_srt(text, offset):
    # SRT timestamps are relative to each chunk. Shift them before joining.
    import re
    def stamp(m):
        h, mi, s, ms = map(int, (m.group(1), m.group(2), m.group(3), m.group(4)))
        total = h*3600000 + mi*60000 + s*1000 + ms + int(offset * 1000)
        hh, rem = divmod(total, 3600000)
        mm, rem = divmod(rem, 60000)
        ss, mss = divmod(rem, 1000)
        return f"{hh:02d}:{mm:02d}:{ss:02d},{mss:03d}"
    return re.sub(r"(\d{2}):(\d{2}):(\d{2}),(\d{3})", stamp, text)

def join_srts(paths, offsets, dest):
    blocks = []
    n = 1
    for path, offset in zip(paths, offsets):
        text = shift_srt(open(path, encoding="utf-8").read(), offset)
        for block in re_split_blocks(text):
            lines = block.strip().splitlines()
            if len(lines) >= 2:
                lines[0] = str(n)
                blocks.append("\n".join(lines))
                n += 1
    with open(dest, "w", encoding="utf-8") as f:
        f.write("\n\n".join(blocks) + "\n")

def re_split_blocks(text):
    return [b for b in text.replace("\r\n", "\n").split("\n\n") if b.strip()]

def concat_media(parts, dest):
    lst = dest + ".txt"
    with open(lst, "w", encoding="utf-8") as f:
        for p in parts:
            f.write(f"file '{os.path.abspath(p)}'\n")
    run(["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", lst, "-c", "copy", dest])
    return dest

def process_long(api_name, label):
    from gradio_client import Client, handle_file
    if not input_file_path or not os.path.exists(input_file_path):
        print("❌ اول فایل را در سلول بالا آپلود کن.")
        return
    work = f"output_media/chunks_{label}"
    if os.path.exists(work):
        shutil.rmtree(work)
    os.makedirs(work, exist_ok=True)

    print(f"✂️ برش به تکه‌های {CHUNK_SEC//60} دقیقه‌ای...")
    parts = split_media(input_file_path, os.path.join(work, "in"))
    print(f"✅ {len(parts)} تکه ساخته شد.")

    client = Client(SPACE)
    done = []
    offsets = []
    t = 0.0
    for i, part in enumerate(parts, 1):
        print(f"⏳ {label} تکه {i}/{len(parts)} ...")
        last_err = None
        for attempt in range(1, 4):
            try:
                result = client.predict(
                    media_file=handle_file(part),
                    voice_name=voice_name,
                    source_lang=source_language,
                    target_lang=target_language,
                    api_name=api_name,
                )
                last_err = None
                break
            except Exception as e:
                last_err = e
                print(f"   تلاش {attempt} خطا داد، ۲۰ ثانیه صبر می‌کنم: {e}")
                time.sleep(20)
                client = Client(SPACE)
        if last_err:
            raise last_err

        ext = ".srt" if "srt" in label or api_name != "/dub_only" else os.path.splitext(part)[1]
        if api_name == "/dub_only" and isinstance(result, str) and os.path.exists(result):
            ext = os.path.splitext(result)[1] or ext
        out = os.path.join(work, f"out_{i:03d}{ext}")
        save_result(result, out)
        done.append(out)
        offsets.append(t)
        t += min(CHUNK_SEC, media_duration(part))
        print(f"✅ تکه {i} تمام شد.")

    if api_name == "/dub_only":
        final = os.path.join("output_media", "dubbed_full" + os.path.splitext(done[0])[1])
        concat_media(done, final)
    else:
        final = os.path.join("output_media", f"{label}_full.srt")
        join_srts(done, offsets, final)

    print(f"📥 فایل نهایی: {final}")
    files.download(final)

btn_t = widgets.Button(description="Transcribe all chunks", button_style="info")
btn_r = widgets.Button(description="Translate all chunks", button_style="warning")
btn_d = widgets.Button(description="Dub all chunks", button_style="success")
chunk_out = widgets.Output()

def _wrap(api, label):
    def inner(b):
        with chunk_out:
            clear_output()
            try:
                process_long(api, label)
            except Exception as e:
                print(f"❌ Error: {e}")
    return inner

btn_t.on_click(_wrap("/transcribe_only", "transcription"))
btn_r.on_click(_wrap("/translate_only", "translation"))
btn_d.on_click(_wrap("/dub_only", "dub"))

display(widgets.HBox([btn_t, btn_r, btn_d]))
display(chunk_out)
