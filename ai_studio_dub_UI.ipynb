#@markdown ### 1. Upload Media & Configure
import os, shutil
from google.colab import files
import ipywidgets as widgets
from IPython.display import display, clear_output, HTML

if os.path.exists("input_media"):
    shutil.rmtree("input_media")
os.makedirs("input_media", exist_ok=True)
if os.path.exists("output_media"):
    shutil.rmtree("output_media")
os.makedirs("output_media", exist_ok=True)

print("📤 Please upload your Video or Audio file:")
uploaded = files.upload()

input_file_path = ""
for filename in uploaded.keys():
    input_file_path = os.path.join("input_media", filename)
    shutil.move(filename, input_file_path)
    print(f"\n✅ File saved: {input_file_path}")

#@markdown ### 2. Settings
voice_name = "charon" #@param ["charon", "puck", "kore", "fenrir", "aoede"]
source_language = "English" #@param ["English", "Auto-Detect"]
target_language = "Persian" #@param ["Persian", "English", "Spanish", "French", "German", "Chinese", "Japanese", "Arabic", "Russian"]

#@markdown ### 3. Actions
btn_transcribe = widgets.Button(description="1. Transcribe", button_style='info', icon='microphone')
btn_translate = widgets.Button(description="2. Translate", button_style='warning', icon='language')
btn_dub = widgets.Button(description="3. Dub", button_style='success', icon='play')
output_area = widgets.Output()

def on_transcribe_click(b):
    with output_area:
        clear_output()
        print("⏳ Transcribing... Please wait.")
        try:
            from gradio_client import Client, handle_file
            client = Client("https://yara85-aigoldendub.hf.space/")
            result = client.predict(
                media_file=handle_file(input_file_path),
                voice_name=voice_name,
                source_lang=source_language,
                target_lang=target_language,
                api_name="/transcribe_only"
            )
            srt_path = "output_media/transcription.srt"
            if isinstance(result, str) and os.path.exists(result):
                shutil.copy(result, srt_path)
            else:
                with open(srt_path, "w", encoding="utf-8") as f:
                    f.write(str(result))
            print(f"✅ Transcription Complete! Saved to: {srt_path}")
            print("-" * 30)
            with open(srt_path, "r", encoding="utf-8") as f:
                print(f.read()[:500] + "...")
            print("-" * 30)
            print("📥 Downloading transcription.srt...")
            files.download(srt_path)
        except Exception as e:
            print(f"❌ Error: {e}")

